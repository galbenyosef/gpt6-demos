{
  "name": "infinicave",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/bun": "1.4.1",
    "@types/three": "0.180.0",
    "fake-indexeddb": "6.2.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "three": "0.180.0",
    "zod": "4.1.5"
  },
  "scripts": {
    "dev": "bun --hot index.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "test:browser": "bun scripts/browser-tests.ts",
    "test:corpus": "bun scripts/seed-corpus.ts",
    "preview": "bun scripts/preview.ts",
    "test:playthrough": "bun scripts/playthrough.ts",
    "format": "bunx prettier --write src scripts tests index.ts index.html playwright.config.ts tsconfig.json package.json README.md specs/implementation.md"
  }
}
