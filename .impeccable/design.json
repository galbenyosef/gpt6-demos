      "css": ".ds-close{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:transparent;color:var(--muted,#626771);cursor:pointer}.ds-close svg{width:22px;height:22px}.ds-close:hover{background:var(--surface,#f5f6f8);color:var(--ink,#17191e)}.ds-close:focus-visible{outline:3px solid var(--accent,#2457d6);outline-offset:6px}"
