{
  "name": "one-more-match",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && electrobun dev",
    "dev:web": "bun --hot apps/server/dev.ts",
    "build": "bun scripts/build.ts",
    "start": "bun apps/server/index.ts",
    "desktop:build": "bun run build && electrobun build --env=stable",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check apps packages scripts tests *.ts *.json",
    "test": "bun test tests/unit.test.ts tests/storage.test.ts tests/server.test.ts",
    "test:e2e": "bun test tests/e2e.test.ts",
    "assets": "bun scripts/player-asset.ts",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.desktop.json",
    "format": "prettier --write apps packages scripts tests *.ts *.json",
    "test:native": "bun run build && bun scripts/native-stability.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "electrobun": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "prettier": "^3.9.6",
    "typescript": "^7"
  },
  "engines": {
    "bun": "1.4.0"
  }
}
