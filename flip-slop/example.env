# Copy this template to .env, then replace the placeholder in .env only.
# Never put a real API key in this example file.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Image model profiles used by the studio.
OPENAI_IMAGE_FAST_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_PRECISE_MODEL=gpt-image-2.5-sunburst

# Optional: leave empty to use the local incremental motion planner.
OPENAI_PLANNER_MODEL=

# Local server and generation limits.
PORT=3000
MAX_BATCH_SIZE=24

# Optional: uncomment to use an existing Chromium executable for browser tests.
# CHROMIUM_PATH="/path/to/chromium"
