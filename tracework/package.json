{
  "name": "tracework",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@openai/agents": "0.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.2",
    "fflate": "0.8.3",
    "lucide-react": "1.47.0",
    "mammoth": "1.12.3",
    "pdfjs-dist": "6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run typecheck && bun --bun node_modules/vite/bin/vite.js build",
    "start": "bun apps/server/src/index.ts",
    "typecheck": "bun --bun node_modules/typescript/bin/tsc --noEmit",
    "test:e2e": "bun --bun node_modules/@playwright/test/cli.js test",
    "test:live": "bun scripts/live.ts",
    "test:execution": "bun scripts/execution-check.ts",
    "demo:seed": "bun scripts/demo.ts seed",
    "demo:reset": "bun scripts/demo.ts reset",
    "execution:prepare": "bun scripts/prepare-execution.ts",
    "benchmark": "bun scripts/benchmark.ts"
  }
}
